+// 18.4.6 has six try blocks. Keep its complete stock implementation in a helper:
+// p0 remains the service in the wrapper even when the stock body reuses it.
+private fun install1846CaptureWrapper(owner: MutableClass, target: MutableMethod) {
+    val helper = "jasondevWebClipboard1846StockOnCreate"
+    check(owner.methods.none { it.name == helper }) { "Web Clipboard helper already exists" }
+    val implementation = checkNotNull(target.implementation)
+    check(implementation.registerCount == 12 && implementation.tryBlocks.size == 6) {
+        "18.4.6 onCreate register/exception contract changed"
+    }
+    val instructions = implementation.instructions
+    check(instructions.count { it.isMethodReference(SUPER_ON_CREATE_DESCRIPTOR) } == 1 &&
+        instructions.count { it.isOpcode("RETURN_VOID") } == 1 &&
+        instructions.none { it.isMethodReferenceInClass(CAPTURE_BOOTSTRAP_RUNTIME_CLASS) }) {
+        "18.4.6 onCreate stock lifecycle contract changed"
+    }
+    val stock = ImmutableMethod(
+        target.definingClass, helper, target.parameters, target.returnType,
+        AccessFlags.PRIVATE.value or AccessFlags.FINAL.value,
+        target.annotations, target.hiddenApiRestrictions, implementation,
+    ).toMutable()
+    check(owner.methods.remove(target) && owner.methods.add(stock))
+    owner.addHelperMethodIfMissing(
+        name = target.name,
+        parameterTypes = emptyList(),
+        returnType = "V",
+        accessFlags = target.accessFlags,
+        registerCount = 1,
+        body = """
+            invoke-direct {p0}, ${target.definingClass}->$helper()V
+            ${RuntimeCallEmitter.invoke(CAPTURE_BOOTSTRAP_RUNTIME_CALL, "p0 .. p0")}
+            return-void
+        """.trimIndent(),
+    )
 }
 
